# BuildLog — local stack configuration.
#
# These credentials are committed on purpose so `docker compose up` needs zero
# manual setup. They are local-only demo values signed with the throwaway JWT
# secret below and are functionally dead outside this compose project.
# NEVER expose this stack to a public network. See SECURITY.md.

############################
# Postgres
############################
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT_HOST=54322

############################
# JWT / API keys
############################
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1idWlsZGxvZyIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzM1Njg5NjAwLCJleHAiOjIwMTk2ODY0MDB9.8mu3rxnFIS-y722xnfsJ02I6d1qoqciFx7ebR-9Ntkc
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1idWlsZGxvZyIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MjAxOTY4NjQwMH0.iluM4GPu8k7qN0spW8oZrgZY_5m1kWTyXJ9rieM04nY

############################
# Public endpoints (host ports)
############################
# Supabase API gateway (Kong): PostgREST, GoTrue, Storage
SUPABASE_PORT=8055
SUPABASE_PUBLIC_URL=http://localhost:8055

# The Next.js app. Served under a subpath, not at the origin root.
APP_PORT=8090
APP_BASE_PATH=/app
SITE_URL=http://localhost:8090/app

# Root-served comparison target (docker compose --profile root-variant up -d)
APP_ROOT_PORT=8091

############################
# Hardened reference (docker compose --profile hardened up -d)
############################
# Which flaw class is fixed. ONE class at a time gives a clean 1:1 differential
# against the vulnerable target; `all` fixes everything.
#   none | rls | secrets | authz | injection | headers | auth | qa | perf | all
HARDEN_CLASS=all
HARDENED_APP_PORT=8092
HARDENED_SUPABASE_PORT=8093
HARDENED_POSTGRES_PORT=54323

############################
# Dials — see MANIFEST.md "Modes"
############################
# Policy applied to public.bookmarks. Same table, columns and seed data in all
# three; only the policy changes.   off | permissive | correct
RLS_MODE=off

# How reachable /api/bookmarks/all is. Same finding, four difficulties.
#   linked | bundle | interaction | concatenated
DISCOVERY_MODE=linked

# Performance fixtures under /app/perf/*. Off by default: a 3s sleep in a normal
# crawl would slow the crawler and could gate off the security and QA probes.
#   on | off
PERF_MODE=off

# CANONICAL MODE is RLS_MODE=off + DISCOVERY_MODE=linked + PERF_MODE=off.
# Any published score against this fixture must state the manifest version and
# both dial settings, or it is not reproducible.

############################
# Client-side integration config
############################
